# VoxDesk environment. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit a real value to this file.
# Capture guide for every variable: docs/CREDENTIALS.md

# ---------------------------------------------------------------------------
# Phase 0 - ElevenLabs
# ---------------------------------------------------------------------------
# elevenlabs.io/app/settings/api-keys
# Keys are RESTRICTED by default. Enable Agents access or the token mint 401s.
ELEVENLABS_API_KEY=

# Written by the first `pnpm agent:push`, or read from the agent page URL.
ELEVENLABS_AGENT_ID=

# ---------------------------------------------------------------------------
# Phase 1 - Cal.com
# ---------------------------------------------------------------------------
# app.cal.com/settings/developer/api-keys  Set expiry to Never Expires.
CAL_API_KEY=

# Numeric id from the event type edit URL: app.cal.com/event-types/<this>
CAL_EVENT_TYPE_ID=

# ---------------------------------------------------------------------------
# Phase 1 - Supabase Postgres
# ---------------------------------------------------------------------------
# Supabase dashboard, Connect button. Not the anon or service_role key.
# Runtime. Transaction pooler, port 6543. Used with prepare:false.
DATABASE_URL=

# Migrations only. Session pooler, port 5432. drizzle-kit needs DDL support.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Phase 1 - Generated locally, `openssl rand -hex 32`
# ---------------------------------------------------------------------------
# Header ElevenLabs sends to the tool routes so they are not open endpoints.
TOOL_SHARED_SECRET=

# Signs the passcode session cookie.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Phase 1 - Chosen by you
# ---------------------------------------------------------------------------
# Typed on a vetting call to open the voice demo.
DEMO_PASSCODE=

# ---------------------------------------------------------------------------
# Phase 3 - ElevenLabs post call webhook
# ---------------------------------------------------------------------------
# Shown once when the webhook is created in ElevenLabs workspace settings.
ELEVENLABS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tunables. Defaults are fine.
# ---------------------------------------------------------------------------
# Max voice sessions per 24h before /api/session returns 429.
DAILY_SESSION_CAP=6

# Used only when a browser reports a timezone that fails IANA validation.
DEFAULT_TIMEZONE=Asia/Karachi
