{
  "name": "voxdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-copy": "scripts/check-copy.sh",
    "e2e": "playwright test",
    "verify:all": "pnpm run typecheck && pnpm exec vitest run && pnpm run check-copy && pnpm exec playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "agent:push": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local agent/push.ts",
    "agent:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local agent/push.ts --run-tests"
  },
  "dependencies": {
    "@elevenlabs/react": "1.12.0",
    "drizzle-orm": "0.45.2",
    "livekit-client": "2.16.1",
    "next": "15.5.22",
    "postgres": "3.4.9",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "livekit-client": "2.16.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
